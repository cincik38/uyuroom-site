{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "adanaotel.uyuroom.com" }],
      "destination": "https://uyuroom.com/tesis/1",
      "statusCode": 301
    },
    { "source": "/rooms", "destination": "/tesisler", "statusCode": 301 },
    { "source": "/rooms/", "destination": "/tesisler", "statusCode": 301 },
    { "source": "/branches", "destination": "/tesisler", "statusCode": 301 },
    { "source": "/branches/", "destination": "/tesisler", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/booking", "destination": "/index.html" },
    { "source": "/booking/", "destination": "/index.html" },
    { "source": "/booking-confirmation", "destination": "/index.html" },
    { "source": "/booking-confirmation/", "destination": "/index.html" },
    { "source": "/personel", "destination": "/index.html" },
    { "source": "/personel/", "destination": "/index.html" },
    { "source": "/karakter-onizleme", "destination": "/index.html" },
    { "source": "/karakter-onizleme/", "destination": "/index.html" },
    { "source": "/giris", "destination": "/index.html" },
    { "source": "/giris/", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/", "destination": "/index.html" },
    { "source": "/yonetim", "destination": "/index.html" },
    { "source": "/yonetim/", "destination": "/index.html" },
    { "source": "/yonetim/:path*", "destination": "/index.html" },
    { "source": "/room/:id", "destination": "/index.html" },
    { "source": "/room/:id/", "destination": "/index.html" },
    { "source": "/tesis/:id", "destination": "/index.html" },
    { "source": "/tesis/:id/", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
